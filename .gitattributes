# LFS rules — Forgejo is the SOLE LFS host. GitHub gets pointers only.
# Belt-and-suspenders: per-remote LFS disable in .git/config + pre-push hook.

models/**/*.litertlm filter=lfs diff=lfs merge=lfs -text
models/**/*.gguf     filter=lfs diff=lfs merge=lfs -text
models/**/*.tflite   filter=lfs diff=lfs merge=lfs -text
models/**/*.onnx     filter=lfs diff=lfs merge=lfs -text
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
models/**/*.bin      filter=lfs diff=lfs merge=lfs -text
models/**/tokenizer.model filter=lfs diff=lfs merge=lfs -text

# Piper voices, when added
voices/**/*.onnx     filter=lfs diff=lfs merge=lfs -text
voices/**/*.json     filter=lfs diff=lfs merge=lfs -text

# ZIM test fixtures (if large)
src-tauri/anzimmermanlib/shared-fixtures/**/*.zim filter=lfs diff=lfs merge=lfs -text

# Text normalization
*.md   text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf

# Binary marker for screenlogs (committed verbatim, not LF-normalized)
LOGS/screenlog.* binary
LOGS/ARCHIVE/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
