#!/bin/bash
# pre-push hook
#
# E-BLD-13: Block LFS blobs from pushing to GitHub mirror.
# This hook enforces the Forgejo-LFS-only policy.
#
# E-BLD-31: Per-remote LFS disable sentinel for `github` remote.
# Clone-time setup required:
#   git config --local remote.github.lfsurl "DISABLED-LFS-DO-NOT-PUSH-BLOBS"
#
# The sentinel value "DISABLED-LFS-DO-NOT-PUSH-BLOBS" in lfsurl is a
# belt-and-suspenders mechanism: this hook blocks pushes, and the invalid
# lfsurl prevents git-lfs from even attempting to contact the GitHub remote.
#
# Forgejo (origin) is the sole LFS host. GitHub is a mirror-only remote
# for external tool access (Jules, Codex) and must never receive LFS blobs.

set -e

remote="$1"
url="$2"

# Only check pushes to the github remote
if [ "$remote" != "github" ]; then
    exit 0
fi

# Check if any LFS pointers are being pushed
# We scan the refs being pushed for Git LFS pointer files
z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = $z40 ]; then
        # Branch deletion, skip
        continue
    fi

    if [ "$remote_sha" = $z40 ]; then
        # New branch, check all commits in this branch
        range="$local_sha"
    else
        # Update to existing branch, check only new commits
        range="$remote_sha..$local_sha"
    fi

    # Check for LFS pointer files in the commits being pushed
    # LFS pointers have the version string "version https://git-lfs.github.com/spec/v1"
    if git rev-list --objects "$range" 2>/dev/null | \
        git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize)' --batch-all-objects 2>/dev/null | \
        grep -E '^blob [0-9a-f]{40} [0-9]+$' | \
        cut -d' ' -f2 | \
        xargs -I {} git cat-file blob {} 2>/dev/null | \
        grep -q 'version https://git-lfs.github.com/spec/v1'; then
        echo "ERROR: LFS blobs detected in push to 'github' remote."
        echo ""
        echo "The GitHub mirror is configured to NOT receive LFS blobs."
        echo "LFS hosting is provided by Forgejo (origin) only."
        echo ""
        echo "To fix this commit:"
        echo "  1. Ensure LFS files are tracked in .gitattributes"
        echo "  2. Run: git lfs migrate import --include='<pattern>'"
        echo "  3. Force push the corrected history"
        echo ""
        echo "Per-remote LFS disable (E-BLD-31):"
        echo "  git config --local remote.github.lfsurl \"DISABLED-LFS-DO-NOT-PUSH-BLOBS\""
        exit 1
    fi
done

exit 0
