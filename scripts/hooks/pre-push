#!/bin/bash
# pre-push hook
#
# E-BLD-13: Block LFS blobs from pushing to any remote except `forgejo`.
# This hook enforces the Forgejo-LFS-only policy.
#
# Roles (2026-07-11 reversal from the original github-mirror convention):
# `origin` (github.com/rebots-online/EnZIME) is primary/default push target
# but must NEVER receive LFS blobs (GitHub LFS is metered billing).
# `forgejo` (forgejo.robin.mba/rcheung/EnZIME) is the full mirror and sole
# LFS host.
#
# E-BLD-31: Per-remote LFS disable sentinel for `origin`.
# Clone-time setup required:
#   git config --local remote.origin.lfsurl "DISABLED-LFS-DO-NOT-PUSH-BLOBS"
#
# The sentinel value "DISABLED-LFS-DO-NOT-PUSH-BLOBS" in lfsurl is a
# belt-and-suspenders mechanism: this hook blocks pushes, and the invalid
# lfsurl prevents git-lfs from even attempting to contact the GitHub remote.

set -e

remote="$1"
url="$2"

# forgejo is the sole LFS host — always allowed, delegate straight to git-lfs
if [ "$remote" = "forgejo" ]; then
    if command -v git-lfs >/dev/null 2>&1; then
        exec git lfs pre-push "$@"
    fi
    exit 0
fi

# Every other remote: block if LFS pointer blobs are part of this push
z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = $z40 ]; then
        # Branch deletion, skip
        continue
    fi

    if [ "$remote_sha" = $z40 ]; then
        # New branch, check all commits in this branch
        range="$local_sha"
    else
        # Update to existing branch, check only new commits
        range="$remote_sha..$local_sha"
    fi

    # Check for LFS pointer files in the commits being pushed.
    # A real LFS pointer's FIRST line is exactly this string, nothing else on
    # the line — match whole-line (-x) so this doesn't false-positive on this
    # very script, whose own grep call contains the string as a substring.
    if git rev-list --objects "$range" 2>/dev/null | \
        git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize)' --batch-all-objects 2>/dev/null | \
        grep -E '^blob [0-9a-f]{40} [0-9]+$' | \
        cut -d' ' -f2 | \
        xargs -I {} git cat-file blob {} 2>/dev/null | \
        grep -qx 'version https://git-lfs.github.com/spec/v1'; then
        echo "ERROR: LFS blobs detected in push to '$remote' remote."
        echo ""
        echo "Only 'forgejo' (forgejo.robin.mba/rcheung/EnZIME) may receive LFS blobs."
        echo "GitHub (origin, primary) must never receive them — metered billing."
        echo ""
        echo "To fix this commit:"
        echo "  1. Ensure LFS files are tracked in .gitattributes"
        echo "  2. Run: git lfs migrate import --include='<pattern>'"
        echo "  3. Force push the corrected history"
        echo ""
        echo "Per-remote LFS disable (E-BLD-31):"
        echo "  git config --local remote.origin.lfsurl \"DISABLED-LFS-DO-NOT-PUSH-BLOBS\""
        exit 1
    fi
done

exit 0
