# EnZIME .env template — copy to .env and fill cleartext values from DOCS/CREDENTIALS.md

# ── Mirror signing keys (ed25519) ─────────────────────────────────────────────────────
# Used by scripts/sign-mirror-manifest.sh and scripts/sign-pack-catalog.sh
MIRROR_PRIV_HEX=<64-hex-chars>
MIRROR_PRIV_B64=<base64>
MIRROR_PUB_HEX=<64-hex-chars>
MIRROR_PUB_B64=<base64>

# ── Release signing key (ed25519) ──────────────────────────────────────────────────────
# Used by scripts/sign-release.sh for detached signatures
RELEASE_PRIV_HEX=<64-hex-chars>

# ── Update signing keys (ed25519) ───────────────────────────────────────────────────────
# Used for update manifest signing (future)
UPDATE_PRIV_HEX=<64-hex-chars>
UPDATE_PRIV_B64=<base64>
UPDATE_PUB_HEX=<64-hex-chars>
UPDATE_PUB_B64=<base64>

# ── Android keystore credentials ────────────────────────────────────────────────────────
# Used by scripts/sign-release.sh for APK/AAB signing
KEYSTORE_PATH=production.keystore
KEYSTORE_PASSWORD=<see DOCS/CREDENTIALS.md>
KEY_PASSWORD=<see DOCS/CREDENTIALS.md>

# ── EntitlementSyncBridge credentials ───────────────────────────────────────────────────
# Used by bridge/src/main.rs
BRIDGE_RC_SECRET=<revenuecat-api-secret>
BRIDGE_HMAC_SECRET=<hmac-shared-secret>
BRIDGE_DB_PATH=./bridge_ledger.db
BRIDGE_BIND_ADDR=[::]:47921

# ── EnZIME billing configuration ───────────────────────────────────────────────────────
# Used by src-tauri/src/billing/revenuecat.rs and src-tauri/src/billing/paywall.rs
ENZIME_RC_API_KEY=<revenuecat-api-key>
ENZIME_BILLING_PROCESSOR=stripe

# ── Android build configuration ──────────────────────────────────────────────────────────
# Used by scripts/build-android.sh
ANDROID_NDK_HOME=/path/to/android-ndk

# ── Optional payment processor credentials ─────────────────────────────────────────────
# HF_TOKEN=<hf_xxx>
# STRIPE_SECRET_KEY=<sk_live_xxx>
# BTCPAY_API_KEY=<token>
