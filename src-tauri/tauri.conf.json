{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "EnZIME",
  "version": "0.1.0",
  "identifier": "mba.robin.enzime",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:38417",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EnZIME",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "android": { "minSdkVersion": 26, "versionCode": 100000 }
  }
}
